// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  name                  String?
  email                 String                 @unique
  password              String
  role                  String                 @default("STUDENT")
  createdAt             DateTime               @default(now())
  coursesTaught         Course[]               @relation("TeacherCourses")
  enrollments           Enrollment[]
  assignmentSubmissions AssignmentSubmission[]
  studentProfile        StudentProfile?
  announcements         Announcement[]         @relation("AnnouncementAuthor")

  privateFiles   PrivateFile[]
  privateFolders PrivateFolder[]

  quizAttempts QuizAttempt[]
}

model PendingRegistration {
  id                    Int                    @id @default(autoincrement())
  name                  String
  email                 String                 @unique
  passwordHash          String
  otpHash               String
  expiresAt             DateTime
  attempts              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  enrollments           Enrollment[]
  AssignmentSubmissions AssignmentSubmission[]
}

model Course {
  id          Int    @id @default(autoincrement())
  code        String @unique
  title       String
  description String @default("")
  instructor  String @default("")
  teacherId   Int?

  // Additional course details
  thumbnail      String @default("")
  credits        Int    @default(4)
  category       String @default("In Progress")
  schedule       String @default("Schedule not set")
  instructorRole String @default("Instructor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher            User?          @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments        Enrollment[]
  assignments        Assignment[]
  announcements      Announcement[]
  officeHours        String         @default("")
  syllabusUrl        String         @default("")
  learningObjectives String[]       @default([])

  quizzes Quiz[]

  @@index([teacherId])
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int
  courseId   Int
  progress   Int      @default(0)
  status     String   @default("IN_PROGRESS")
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student               User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course                Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pendingRegistration   PendingRegistration? @relation(fields: [pendingRegistrationId], references: [id])
  pendingRegistrationId Int?

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Assignment {
  id            Int      @id @default(autoincrement())
  courseId      Int
  title         String
  description   String   @default("")
  dueDate       DateTime
  totalPoints   Int      @default(100)
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  @@index([courseId, dueDate])
}

model AssignmentSubmission {
  id            Int      @id @default(autoincrement())
  assignmentId  Int
  studentId     Int
  content       String   @default("")
  fileUrl       String?
  status        String   @default("SUBMITTED")
  score         Int?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  feedback      String?
  attachmentUrl String?

  assignment            Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student               User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pendingRegistration   PendingRegistration? @relation(fields: [pendingRegistrationId], references: [id])
  pendingRegistrationId Int?

  @@unique([assignmentId, studentId])
  @@index([status])
  @@index([studentId])
}

model StudentProfile {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  phone                String?
  dob                  DateTime?
  gender               String?
  bloodGroup           String?
  bio                  String?
  avatar               String?
  street               String?
  city                 String?
  state                String?
  pincode              String?
  emergencyContactName String?
  emergencyPhone       String?
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  message   String   @db.Text
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseId Int
  authorId Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([authorId])
}

model PrivateFolder {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files PrivateFile[]

  @@unique([userId, name])
  @@index([userId])
}

model PrivateFile {
  id           Int      @id @default(autoincrement())
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  userId       Int
  folderId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder PrivateFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([folderId])
}

model Quiz {
  id              Int       @id @default(autoincrement())
  courseId        Int
  title           String
  description     String    @default("")
  durationMinutes Int       @default(30)
  totalMarks      Int       @default(100)
  status          String    @default("DRAFT")
  windowStart     DateTime?
  windowEnd       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([status])
}

model QuizQuestion {
  id            Int     @id @default(autoincrement())
  quizId        Int
  question      String
  options       Json
  correctAnswer String
  explanation   String?
  points        Int     @default(1)
  order         Int     @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, order])
}

model QuizAnswer {
  id             Int      @id @default(autoincrement())
  attemptId      Int
  questionId     Int
  selectedOption String?
  isCorrect      Boolean?
  pointsAwarded  Int      @default(0)

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  studentId   Int
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  status      String    @default("IN_PROGRESS")
  score       Int?
  percentage  Float?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, studentId])
  @@index([studentId])
}
